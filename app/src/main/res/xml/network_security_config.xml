<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- AppLens never talks to the internet. Clear-text is allowed only so that the
         DNS resolver used by the capture VPN can reach plaintext DNS resolvers. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
