<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="14dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/titleText"
                style="@style/T.title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AppLens" />

            <TextView
                android:id="@+id/subtitleText"
                style="@style/T.small"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="On-device application monitor" />
        </LinearLayout>

        <TextView
            android:id="@+id/rootChip"
            style="@style/T.label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="ROOT" />
    </LinearLayout>

    <!-- Previously scanned / recently opened -->
    <LinearLayout
        android:id="@+id/recentsBlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="12dp">

        <TextView
            style="@style/T.label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingBottom="6dp"
            android:text="PREVIOUSLY SCANNED" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/recentsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="18dp"
                android:paddingEnd="18dp" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_search"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                android:contentDescription="@string/search" />

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/text_faint"
                android:textSize="14sp"
                android:paddingStart="10dp"
                android:paddingEnd="0dp"
                android:hint="Search apps…" />
        </LinearLayout>

        <TextView
            android:id="@+id/sortButton"
            style="@style/T.label"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_button_ghost"
            android:paddingStart="12dp"
            android:paddingEnd="14dp"
            android:drawablePadding="6dp"
            android:clickable="true"
            android:focusable="true"
            android:text="Name" />
    </LinearLayout>

    <!-- Filter chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/filterRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <!-- Status strip -->
    <TextView
        android:id="@+id/statusText"
        style="@style/T.small"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="2dp"
        android:text="" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/appList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingBottom="12dp"
            android:divider="@null"
            android:dividerHeight="0dp"
            android:scrollbarStyle="outsideOverlay" />

        <ProgressBar
            android:id="@+id/loading"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminateTint="@color/accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/emptyText"
            style="@style/T.body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:padding="32dp"
            android:gravity="center"
            android:visibility="gone"
            android:text="No application matches your search" />
    </FrameLayout>

    <!-- Bottom action bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/scanButton"
            style="@style/T.label"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_weight="1"
            android:gravity="center"
            android:background="@drawable/bg_button_primary"
            android:textColor="#FF04121A"
            android:drawablePadding="8dp"
            android:clickable="true"
            android:focusable="true"
            android:text="SCAN APPS" />

        <TextView
            android:id="@+id/diagnosticsButton"
            style="@style/T.label"
            android:layout_width="68dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_button_ghost"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open crash and error diagnostics"
            android:text="DIAG" />

        <TextView
            android:id="@+id/logsButton"
            style="@style/T.label"
            android:layout_width="52dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:gravity="center"
            android:background="@drawable/bg_button_ghost"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Open activity record files"
            android:text="TXT" />
    </LinearLayout>
</LinearLayout>
